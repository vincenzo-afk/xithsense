# ── XithSense Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your actual values

# Runtime
ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_A_32_CHAR_MIN_RANDOM_STRING_XXXXXXXXXXX
XITHSENSE_API_KEY=xs-dev-changeme

# ── Database ──────────────────────────────────────────────────────────
# Zero-setup local default is SQLite. For production use PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/xithsense
DATABASE_URL=sqlite+aiosqlite:///./xithsense.db
# Supabase (optional — leave blank to use local Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant (Vector DB) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LLM (choose one) ─────────────────────────────────────────────────
# Powers the AI assistant (tool-calling agent) and explanation rephrasing. Optional: without a
# key the assistant answers from the engine's grounded data only.
LLM_PROVIDER=groq
# Options: groq | anthropic | openai | google
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Override the provider default model (groq: llama-3.3-70b-versatile, anthropic: claude-sonnet-5-5,
# openai: gpt-4o-mini, google: gemini-2.0-flash)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=5
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=45

# ── Web research for the assistant ───────────────────────────────────
# Cricket news, injuries, playing XI, pitch reports. DuckDuckGo needs no key; Tavily is better when set.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# ── Data Paths ────────────────────────────────────────────────────────
CRICSHEET_DATA_PATH=data/raw/all_json/
MODEL_ARTIFACTS_PATH=models/artifacts/
FEATURE_STORE_PATH=data/features/

# ── Payments (Razorpay) ────────────────────────────────────────────────
# Without keys checkout is disabled (503); admins can grant Premium from the console
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Weather API ───────────────────────────────────────────────────────
WEATHER_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.xithsense.com

# ── Ensemble weights (must sum to 1) ──────────────────────────────────
ENSEMBLE_ML_WEIGHT=0.40
ENSEMBLE_HUMAN_RULES_WEIGHT=0.30
ENSEMBLE_FORM_WEIGHT=0.20
ENSEMBLE_LIVE_WEIGHT=0.10

# ── Live data: cricketdata.org (CricAPI v1) ───────────────────────────
# Fixtures, toss, live scores and scorecards. Free plan = 100 hits/day:
# list calls cost 1 hit, squads and scorecards cost 10. Get a key at https://cricketdata.org
CRICKETDATA_API_KEY=
CRICKETDATA_DAILY_LIMIT=100
CRICKETDATA_RESERVE=10
LIVE_POLL_SECONDS=240
LIVE_SCORECARD_MINUTES=45
FIXTURE_SYNC_HOURS=12
FIXTURE_DAYS_AHEAD=10
TRACKED_SERIES_MAX=8

# ── Dev ───────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
